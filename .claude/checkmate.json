{
  "environments": [
    {
      "name": "root",
      "paths": ["."],
      "exclude": ["target/**", "coverage/**"],
      "checks": {
        ".rs": [
          { "name": "rustfmt", "command": "rustfmt", "args": ["--check", "$FILE"], "parser": "prettier", "_auto": true },
          { "name": "clippy", "command": "cargo", "args": ["clippy", "--", "-D", "warnings", "$FILE"], "parser": "generic", "_auto": true }
        ]
      }
    }
  ]
}
