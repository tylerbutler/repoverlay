---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import "@fontsource/metropolis/400.css";
import "@fontsource/metropolis/600.css";
import "@fontsource/metropolis/700.css";
import "@fontsource/metropolis/800.css";
import "../styles/tokens.css";
import logo from "../assets/repoverlay.svg";
import CopyButton from "../components/CopyButton.astro";

const description =
	"Overlay AI configs, editor settings, and dev tooling into any git repo. Files are symlinked or copied into place and excluded through .git/info/exclude.";
const ghUrl = "https://github.com/tylerbutler/repoverlay";
const firstRunCommand = "repoverlay profile apply rust-dev --harness claude";
const cargoTomlPath = [resolve(process.cwd(), "Cargo.toml"), resolve(process.cwd(), "../Cargo.toml")].find(
	existsSync,
);
if (!cargoTomlPath) {
	throw new Error("Could not find repoverlay Cargo.toml");
}
const cargoToml = readFileSync(cargoTomlPath, "utf8");
const versionMatch = cargoToml.match(/^version\s*=\s*"([^"]+)"/m);
if (!versionMatch) {
	throw new Error("Could not read repoverlay version from Cargo.toml");
}
const release = versionMatch[1];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og.png", Astro.site).href;
const ogImageAlt =
	"repoverlay: share configs across repos, commit nothing. Terminal showing files excluded via .git/info/exclude.";

const installs = [
	{ label: "Homebrew", cmd: "brew install tylerbutler/tap/repoverlay" },
	{ label: "Cargo", cmd: "cargo binstall repoverlay" },
];

const browseExample = "repoverlay browse tylerbutler/overlays";
const applyExample = "repoverlay apply tylerbutler/overlays/claude";

const mechanism = [
	{
		stage: "Source",
		title: "Point at a source",
		body: "Name an overlay by owner, repo, and path, or browse a source to see what is available.",
		artifact: "tylerbutler/overlays/claude",
	},
	{
		stage: "Place",
		title: "Files land in the working tree",
		body: "repoverlay symlinks each file into place, or copies it on Windows and whenever you ask.",
		artifact: ".claude/settings.json",
	},
	{
		stage: "Exclude",
		title: "Git never sees them",
		body: "Every placed path is added to .git/info/exclude, so .gitignore and history stay untouched.",
		artifact: ".git/info/exclude",
	},
	{
		stage: "Restore",
		title: "Survives git clean",
		body: "State is backed up outside the repo, so repoverlay restore re-applies everything after a wipe.",
		artifact: "~/.local/share/repoverlay/applied/",
	},
];

const capabilities = [
	{
		title: "Symlink or copy",
		body: "Symlinked by default on macOS and Linux for instant edits; copied on Windows or on request.",
		code: "--copy",
	},
	{
		title: "GitHub-aware sources",
		body: "Pull overlays from repos, branches, tags, or subdirectories, cached with shallow clones.",
		code: "owner/repo@tag",
	},
	{
		title: "Fork inheritance",
		body: "On a fork, repoverlay falls back to the upstream repo's overlays until yours exist.",
		code: "origin → upstream",
	},
];

const placed = [
	{ kind: "skills", name: "rustfmt + clippy skills", path: ".claude/skills/rust/" },
	{ kind: "agent", name: "cargo-review agent", path: ".claude/agents/cargo-review/" },
	{ kind: "mcp", name: "crates.io MCP server", path: ".mcp.json" },
	{ kind: "rules", name: "Rust house style", path: "CLAUDE.md" },
];

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#14151f" media="(prefers-color-scheme: dark)" />
			<meta name="theme-color" content="#f6f7fc" media="(prefers-color-scheme: light)" />
			<link rel="icon" href={logo.src} type="image/svg+xml" />
			<link rel="canonical" href={canonicalUrl} />
		<title>repoverlay: share configs across repos, commit nothing</title>
		<meta name="description" content={description} />
		<meta property="og:title" content="repoverlay" />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
			<meta property="og:url" content={canonicalUrl} />
			<meta property="og:site_name" content="repoverlay" />
			<meta property="og:image" content={ogImageUrl} />
			<meta property="og:image:width" content="2400" />
			<meta property="og:image:height" content="1260" />
			<meta property="og:image:alt" content={ogImageAlt} />
			<meta name="twitter:card" content="summary_large_image" />
			<meta name="twitter:title" content="repoverlay" />
			<meta name="twitter:description" content={description} />
			<meta name="twitter:image" content={ogImageUrl} />
			<meta name="twitter:image:alt" content={ogImageAlt} />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			(() => {
				const query = window.matchMedia?.("(prefers-color-scheme: light)");
				let savedTheme = null;
				try {
					const stored = window.localStorage.getItem("starlight-theme");
					if (stored === "dark" || stored === "light") savedTheme = stored;
				} catch {
					/* localStorage can be blocked; fall back to OS preference. */
				}
				document.documentElement.dataset.theme =
					savedTheme ?? (query?.matches ? "light" : "dark");
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div
			class="sr-only"
			role="status"
			aria-live="polite"
			aria-atomic="true"
			data-copy-status
		></div>

		<div class="release" role="note">
			<span class="release__dot" aria-hidden="true"></span>
			<span>Current release: repoverlay {release}.</span>
			<a href={`${ghUrl}/releases`}>Release notes</a>
		</div>

		<header class="nav">
			<div class="nav__inner">
				<a class="brand" href="/" aria-label="repoverlay home">
					<img src={logo.src} alt="" width="28" height="31" />
					<span>repoverlay</span>
				</a>
				<nav class="nav__links" aria-label="Primary">
					<a href="/introduction/">Docs</a>
					<a href="/quick-start/">Quick Start</a>
					<a href="/cli-reference/">CLI</a>
					<button
						class="nav__theme"
						type="button"
						data-theme-toggle
						aria-label="Switch color theme"
					>
						<span class="nav__theme-icon nav__theme-icon--moon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18"
								><path
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
							>
						</span>
						<span class="nav__theme-icon nav__theme-icon--sun" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18"
								><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle><path
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
							>
						</span>
					</button>
					<a class="nav__gh" href={ghUrl} aria-label="repoverlay on GitHub">
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
							><path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path></svg
						>
					</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<!-- HERO: asymmetric split -->
			<section class="hero">
				<div class="hero__copy reveal">
					<h1>
						Load your agent's setup per repo.<br /><span class="accentword"
							>Commit nothing.</span
						>
					</h1>
					<p class="lede">
						Apply a profile and repoverlay places skills, agents, MCP servers, and
						instructions into the repo for your AI assistant, alongside any shared
						configs and dotfiles. Everything is git-excluded; nothing is committed.
					</p>
					<div class="cta-row">
						<a class="btn btn--primary" href="/quick-start/">
							Start with Quick Start
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
								><path
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M5 12h14M13 6l6 6-6 6"></path></svg
							>
						</a>
						<a class="btn btn--ghost" href="/introduction/">Read the docs</a>
					</div>
					<p class="hero__note">
						New repo? Apply a profile and your agent is ready: skills, tools, and
						house rules, scoped to the checkout.
					</p>
				</div>

				<div class="hero__panel reveal" style="--delay:90ms">
					<div class="shell" aria-label="Profile apply shell session">
						<div class="shell__bar">
							<span class="shell__name">apply a profile</span>
							<button
								class="copy"
								type="button"
								data-copy={firstRunCommand}
								aria-label="Copy profile apply command"
							>
								<span class="copy__label">Copy command</span>
							</button>
						</div>
						<pre class="shell__body"><code><span class="ln dim">  One profile composes overlays and agent capabilities.</span>
<span class="ln"><span class="pr">$</span> repoverlay profile apply rust-dev <span class="dim">--harness claude</span></span>
<span class="ln dim">  Placing skills, an agent, an MCP server, and instructions.</span>
<span class="ln dim">  Repo-local files excluded via .git/info/exclude.</span>
<span class="ln"><span class="ok">✓</span> Applied rust-dev · 4 capabilities, 0 files committed</span>
<span class="ln"><span class="pr">$</span> <span class="caret" aria-hidden="true">▍</span></span></code></pre>
						</div>
					<div class="manifest">
						<div class="manifest__head">
							<span class="manifest__title">rust-dev applied</span>
							<span class="manifest__guard">git-excluded, removable</span>
						</div>
						<ul
							class="manifest__list"
							aria-label="Capabilities placed by the rust-dev profile, excluded from git"
						>
							{
								placed.map((c) => (
									<li class="manifest__row">
										<span class={`manifest__kind manifest__kind--${c.kind}`}>
											{c.kind}
										</span>
										<span class="manifest__info">
											<span class="manifest__file">{c.name}</span>
											<code class="manifest__src">{c.path}</code>
										</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<!-- INSTALL: one line to the binary -->
			<section class="install-strip reveal" aria-label="Install repoverlay">
				<div class="install-strip__intro">
					<span class="install-strip__eyebrow">One binary, no runtime</span>
					<p class="install-strip__line">
						Install once, then overlay any repo. Pick your package manager:
					</p>
				</div>
				<ul class="install-strip__options">
					{
						installs.map((opt) => (
							<li class="cmdline">
								<span class="cmdline__manager">{opt.label}</span>
								<code class="cmdline__text"><span class="pr">$</span> {opt.cmd}</code>
								<CopyButton command={opt.cmd} label={`Copy ${opt.label} install command`} />
							</li>
						))
					}
				</ul>
			</section>

			<!-- PROBLEM: editorial statement -->
			<section class="problem reveal">
				<div class="problem__lead">
					<h2>Some files don't belong in the repo.</h2>
					<p>
						AI assistant configs, editor settings, local environment files, the
						tooling you carry between projects. You want them in every checkout,
						but committing them clutters history, and git clean wipes them.
					</p>
				</div>
				<ul class="configs" aria-label="Examples of files repoverlay manages">
					<li><span>AI assistants</span><code>.claude/ · CLAUDE.md</code></li>
					<li><span>Editor settings</span><code>.vscode/settings.json</code></li>
					<li><span>Environment</span><code>.envrc · .env.local</code></li>
					<li><span>Dev tooling</span><code>.prettierrc · biome.json</code></li>
				</ul>
			</section>

			<!-- MECHANISM: the overlay lifecycle -->
			<section class="mechanism reveal" aria-label="How an overlay is applied">
				<div class="mechanism__head">
					<h2 class="section-head">An overlay's whole life, in four moves.</h2>
					<p class="mechanism__sub">
						repoverlay places files, hides them from git, and can put them back.
						Browse a source to see what's on offer:
					</p>
					<div class="cmdline cmdline--browse">
						<code class="cmdline__text"><span class="pr">$</span> {browseExample}</code>
						<CopyButton command={browseExample} label="Copy browse command" />
					</div>
				</div>
				<ol class="mechanism__track">
					{
						mechanism.map((m) => (
							<li class="mechanism__stage">
								<span class="mechanism__label">{m.stage}</span>
								<h3>{m.title}</h3>
								<p>{m.body}</p>
								<code class="mechanism__artifact">{m.artifact}</code>
							</li>
						))
					}
				</ol>
				<div class="mechanism__apply">
					<div class="mechanism__apply-copy">
						<span class="mechanism__apply-eyebrow">Know the reference?</span>
						<p>Skip the picker and apply an overlay straight away.</p>
					</div>
					<div class="cmdline cmdline--apply">
						<code class="cmdline__text"><span class="pr">$</span> {applyExample}</code>
						<CopyButton command={applyExample} label="Copy example apply command" />
					</div>
				</div>
			</section>

			<!-- CAPABILITIES: editorial spec list -->
			<section class="capabilities reveal" aria-label="What else repoverlay does">
				<h2 class="section-head">And the details that make it livable.</h2>
				<ul class="capabilities__list">
					{
						capabilities.map((c) => (
							<li class="capability">
								<div class="capability__head">
									<h3>{c.title}</h3>
									<code class="capability__code">{c.code}</code>
								</div>
								<p>{c.body}</p>
							</li>
						))
					}
				</ul>
			</section>

			<!-- FINAL CTA -->
			<section class="final reveal">
				<h2>Stop copying configs by hand.</h2>
				<p>Define your overlays once, apply them anywhere, recover them anytime.</p>
				<div class="cta-row cta-row--center">
					<a class="btn btn--primary" href="/quick-start/">
						Open Quick Start
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
							><path
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M5 12h14M13 6l6 6-6 6"></path></svg
						>
					</a>
					<a class="btn btn--ghost" href={ghUrl}>View source</a>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="foot__inner">
				<div class="foot__brand">
					<a class="brand" href="/">
						<img src={logo.src} alt="" width="26" height="29" />
						<span>repoverlay</span>
					</a>
					<p>Overlay config files into git repositories without committing them.</p>
				</div>
				<nav class="foot__cols" aria-label="Footer">
					<div>
						<h4>Docs</h4>
						<a href="/introduction/">Introduction</a>
						<a href="/installation/">Installation</a>
						<a href="/quick-start/">Quick Start</a>
						<a href="/cli-reference/">CLI Reference</a>
					</div>
					<div>
						<h4>Project</h4>
						<a href={ghUrl}>GitHub</a>
						<a href={`${ghUrl}/releases`}>Releases</a>
						<a href={`${ghUrl}/issues`}>Issues</a>
					</div>
				</nav>
			</div>
			<div class="foot__base">
				<span>MIT licensed</span>
				<span>Built by Tyler Butler</span>
			</div>
		</footer>

		<script>
			const themeStorageKey = "starlight-theme";
			const colorSchemeQuery = window.matchMedia?.("(prefers-color-scheme: light)");
			const themeToggle =
				document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
			const syncThemeToggle = () => {
				if (!themeToggle) return;
				const isDark = document.documentElement.dataset.theme !== "light";
				themeToggle.setAttribute(
					"aria-label",
					isDark ? "Switch to light theme" : "Switch to dark theme",
				);
				themeToggle.setAttribute("aria-pressed", String(!isDark));
			};
			const readSavedTheme = () => {
				try {
					const stored = window.localStorage.getItem(themeStorageKey);
					return stored === "dark" || stored === "light" ? stored : null;
				} catch {
					return null;
				}
			};
			const applyPreferredTheme = () => {
				document.documentElement.dataset.theme =
					readSavedTheme() ?? (colorSchemeQuery?.matches ? "light" : "dark");
				syncThemeToggle();
			};
			const applyAutoTheme = () => {
				if (readSavedTheme() === null) applyPreferredTheme();
			};
			syncThemeToggle();
			themeToggle?.addEventListener("click", () => {
				const next =
					document.documentElement.dataset.theme === "light" ? "dark" : "light";
				document.documentElement.dataset.theme = next;
				try {
					window.localStorage.setItem(themeStorageKey, next);
				} catch {
					/* localStorage can be blocked; the in-page toggle still works. */
				}
				syncThemeToggle();
			});
			if (colorSchemeQuery) {
				if (typeof colorSchemeQuery.addEventListener === "function") {
					colorSchemeQuery.addEventListener("change", applyAutoTheme);
				} else {
					colorSchemeQuery.onchange = applyAutoTheme;
				}
			}
			window.addEventListener("storage", (event) => {
				if (event.key === themeStorageKey) applyPreferredTheme();
			});

			// Copy-to-clipboard for shell and command examples.
			const copyStatus =
				document.querySelector<HTMLElement>("[data-copy-status]");
			const announceCopy = (message: string) => {
				if (copyStatus) copyStatus.textContent = message;
			};
			const copyToClipboard = async (text: string) => {
				if (text.length === 0) {
					throw new Error("No text available to copy");
				}
				if (!window.isSecureContext || !navigator.clipboard?.writeText) {
					throw new Error("Clipboard API unavailable");
				}
				await navigator.clipboard.writeText(text);
			};

			document.querySelectorAll<HTMLButtonElement>(".copy").forEach((btn) => {
				let resetTimer: number | undefined;
				btn.addEventListener("click", async () => {
					const text = btn.dataset.copy ?? "";
					const label = btn.querySelector(".copy__label");
					const prev = label?.textContent ?? "Copy command";
					const reset = () => {
						if (label) label.textContent = prev;
						announceCopy("");
						btn.classList.remove("is-copied", "is-failed");
					};
					if (resetTimer) window.clearTimeout(resetTimer);
					try {
						await copyToClipboard(text);
						if (label) label.textContent = "Copied";
						announceCopy(`Copied to clipboard: ${text}`);
						btn.classList.add("is-copied");
					} catch {
						if (label) label.textContent = "Copy failed";
						announceCopy("Copy failed. Select and copy the command manually.");
						btn.classList.add("is-failed");
					}
					resetTimer = window.setTimeout(reset, 1800);
				});
			});

			// Enhancement-only reveals: content stays readable if JS or animations fail.
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const reveals = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
			const canAnimate =
				!reduce && "IntersectionObserver" in window && "animate" in Element.prototype;

			const parseDelay = (el: HTMLElement) => {
				const delay = getComputedStyle(el).getPropertyValue("--delay").trim();
				if (delay.endsWith("ms")) return Number.parseFloat(delay);
				if (delay.endsWith("s")) return Number.parseFloat(delay) * 1000;
				return 0;
			};

			const playReveal = (el: HTMLElement) => {
				if (el.dataset.revealed === "true") return;
				el.dataset.revealed = "true";
				el.classList.add("in");
				const animation = el.animate(
					[
						{ opacity: 0, transform: "translateY(18px)", filter: "blur(6px)" },
						{ opacity: 1, transform: "translateY(0)", filter: "blur(0)" },
					],
					{
						duration: 620,
						delay: parseDelay(el),
						easing: "cubic-bezier(0.16, 1, 0.3, 1)",
					},
				);
				animation.finished.then(
					() => el.classList.remove("is-queued"),
					() => el.classList.remove("is-queued"),
				);
			};

			if (canAnimate) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								playReveal(entry.target as HTMLElement);
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
				);
				reveals.forEach((el) => {
					el.classList.add("is-queued");
					io.observe(el);
				});
			} else {
				reveals.forEach((el) => el.classList.add("in"));
			}
		</script>

		<style is:global>
			:root {
				color-scheme: var(--rv-color-scheme);
				--bg: var(--rv-bg);
				--bg-2: var(--rv-bg-raised);
				--surface: var(--rv-surface);
				--border: var(--rv-border);
				--border-strong: var(--rv-border-strong);
				--text: var(--rv-text);
				--text-2: var(--rv-text-secondary);
				--muted: var(--rv-text-muted);
				--accent: var(--rv-accent);
				--accent-2: var(--rv-accent-deep);
				--accent-soft: var(--rv-accent-soft);
				--accent-line: var(--rv-accent-line);
				--success: var(--rv-success);
				--on-accent: var(--rv-on-accent);
				--radius: var(--rv-radius-lg);
				--radius-sm: var(--rv-radius-md);
				--maxw: var(--rv-layout-max);
				--font: var(--rv-font);
				--mono: var(--rv-mono);
				--ease: var(--rv-ease);
			}

			* {
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
			}
			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font);
				font-size: 17px;
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				text-rendering: optimizeLegibility;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			h1,
			h2,
			h3,
			h4 {
				margin: 0;
				line-height: 1.05;
				letter-spacing: -0.02em;
				font-weight: 800;
			}
			p {
				margin: 0;
			}
			code {
				font-family: var(--mono);
			}

			.skip {
				position: absolute;
				left: -9999px;
				top: 0;
				background: var(--accent);
				color: var(--on-accent);
				padding: 0.6rem 1rem;
				border-radius: var(--radius-sm);
				z-index: 100;
			}
			.skip:focus {
				left: 1rem;
				top: 1rem;
			}
			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
				border-radius: var(--radius-sm);
			}

			/* Release banner */
			.release {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.55rem;
				flex-wrap: wrap;
				min-height: 44px;
				padding: 0 1rem;
				font-size: 0.85rem;
				color: var(--text-2);
				background: var(--bg-2);
				border-bottom: 1px solid var(--border);
			}
			.release__dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--accent);
			}
			.release a {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				padding-inline: 0.15rem;
				color: var(--accent);
				font-weight: 600;
			}
			.release a:hover {
				text-decoration: underline;
			}

			/* Nav */
			.nav {
				position: sticky;
				top: 0;
				z-index: 50;
				background: color-mix(in srgb, var(--bg) 82%, transparent);
				backdrop-filter: saturate(160%) blur(12px);
				border-bottom: 1px solid var(--border);
			}
			.nav__inner {
				max-width: var(--maxw);
				margin: 0 auto;
				height: 64px;
				padding-left: max(1.5rem, env(safe-area-inset-left));
				padding-right: max(1.5rem, env(safe-area-inset-right));
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				justify-content: center;
				min-width: 44px;
				min-height: 44px;
				font-weight: 700;
				letter-spacing: -0.01em;
			}
			.brand img {
				display: block;
			}
			.nav__links {
				display: flex;
				align-items: center;
				gap: 1.6rem;
				font-size: 0.95rem;
				color: var(--text-2);
			}
			.nav__links a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 44px;
				min-height: 44px;
			}
			.nav__links a:hover {
				color: var(--text);
			}
			.nav__gh {
				display: inline-flex;
				justify-content: center;
				width: 44px;
				color: var(--text-2);
			}
			.nav__gh:hover {
				color: var(--accent);
			}
			.nav__theme {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				min-height: 44px;
				padding: 0;
				color: var(--text-2);
				background: transparent;
				border: 0;
				border-radius: var(--radius-sm);
				cursor: pointer;
			}
			.nav__theme:hover {
				color: var(--accent);
			}
			.nav__theme-icon {
				display: inline-flex;
			}
			:root[data-theme="dark"] .nav__theme-icon--sun,
			:root:not([data-theme]) .nav__theme-icon--sun {
				display: none;
			}
			:root[data-theme="light"] .nav__theme-icon--moon {
				display: none;
			}

			/* Shared */
			main {
				max-width: calc(var(--maxw) + 40px);
				margin: 0 auto;
				padding-left: max(1.5rem, env(safe-area-inset-left));
				padding-right: max(1.5rem, env(safe-area-inset-right));
			}
			section {
				padding-block: clamp(3rem, 6.5vw, 5.5rem);
			}
			.section-head {
				font-size: clamp(1.6rem, 3.2vw, 2.3rem);
				margin-bottom: 1.8rem;
			}
			.accentword {
				color: var(--accent);
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				min-height: 44px;
				min-width: 0;
				white-space: normal;
				text-align: center;
				padding: 0.8rem 1.4rem;
				border-radius: 999px;
				font-weight: 600;
				font-size: 1rem;
				border: 1px solid transparent;
				transition:
					transform 0.18s var(--ease),
					background 0.18s var(--ease),
					border-color 0.18s var(--ease);
			}
			.btn svg {
				transition: transform 0.18s var(--ease);
			}
			.btn--primary {
				background: var(--accent);
				color: var(--on-accent);
			}
			.btn--primary:hover {
				transform: translateY(-2px);
				background: color-mix(in srgb, var(--accent) 88%, var(--rv-hover-tint));
			}
			.btn--primary:hover svg {
				transform: translateX(3px);
			}
			.btn--primary:active {
				transform: translateY(0);
			}
			.btn--ghost {
				background: transparent;
				color: var(--text);
				border-color: var(--border-strong);
			}
			.btn--ghost:hover {
				transform: translateY(-2px);
				border-color: var(--accent-line);
				background: var(--accent-soft);
			}
			.btn--ghost:active {
				transform: translateY(0);
			}

			.cta-row {
				display: flex;
				gap: 0.9rem;
				flex-wrap: wrap;
			}
			.cta-row--center {
				justify-content: center;
			}

			/* Hero */
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
				gap: clamp(2.4rem, 6vw, 5.5rem);
				align-items: center;
				padding-top: clamp(3rem, 6vw, 5.5rem);
				overflow: clip;
			}
			.hero__copy,
			.hero__panel {
				min-width: 0;
				max-width: 100%;
			}
			.hero h1 {
				max-width: min(12ch, 100%);
				font-size: clamp(3rem, 7.8vw, 5.4rem);
				letter-spacing: -0.04em;
				text-wrap: balance;
			}
			.lede {
				margin-top: 1.4rem;
				max-width: min(38ch, 100%);
				color: var(--text-2);
				font-size: clamp(1.05rem, 1.6vw, 1.2rem);
			}
			.cta-row {
				margin-top: 2rem;
			}
			.hero__note {
				max-width: min(36ch, 100%);
				margin-top: 0.95rem;
				color: var(--text-2);
				font-size: 0.95rem;
				text-wrap: pretty;
			}
			/* Shell panel */
			.hero__panel {
				position: relative;
				isolation: isolate;
				padding-block: clamp(1.2rem, 3vw, 2.2rem);
			}
			.hero__panel::before {
				content: "";
				position: absolute;
				inset: -12% -16% -20% 10%;
				background: radial-gradient(
					60% 60% at 70% 25%,
					var(--accent-soft),
					transparent 70%
				);
				filter: blur(8px);
				z-index: -3;
			}
			.hero__panel::after {
				content: "";
				position: absolute;
				inset: 1.6rem -0.7rem 0.4rem 0.95rem;
				border-radius: var(--radius);
				background: color-mix(in srgb, var(--accent) 86%, var(--accent-2));
				z-index: -2;
			}
			.shell {
				position: relative;
				z-index: 1;
				border: 1px solid var(--border-strong);
				border-radius: var(--radius);
				background: var(--surface);
				box-shadow: var(--rv-shadow-shell);
				overflow: hidden;
			}
			.shell__bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.8rem;
				padding: 0.6rem 0.85rem;
				border-bottom: 1px solid var(--border);
				background: color-mix(in srgb, var(--surface) 70%, var(--bg));
			}
			.shell__name {
				font-family: var(--mono);
				font-size: 0.78rem;
				color: var(--muted);
			}
			.copy {
				flex: 0 0 auto;
				font-family: var(--font);
				font-size: 0.78rem;
				min-width: 44px;
				min-height: 44px;
				color: var(--text-2);
				background: transparent;
				border: 1px solid var(--border-strong);
				border-radius: 7px;
				padding: 0.35rem 0.7rem;
				cursor: pointer;
				transition:
					color 0.15s var(--ease),
					border-color 0.15s var(--ease);
			}
			.copy:hover {
				color: var(--text);
				border-color: var(--accent-line);
			}
			.copy.is-copied {
				color: var(--accent);
				border-color: var(--accent-line);
			}
			.copy.is-failed {
				color: var(--text);
				border-color: var(--accent);
				background: var(--accent-soft);
			}
			.copy--inline {
				flex: 0 0 auto;
				padding: 0;
				color: var(--muted);
				border-color: transparent;
				font-family: inherit;
			}
			.copy--inline:hover {
				color: var(--text);
				border-color: var(--accent-line);
			}
			.copy--inline.is-copied {
				color: var(--accent);
				border-color: var(--accent-line);
			}
			.copy--inline.is-failed {
				color: var(--accent);
				border-color: var(--accent);
				background: var(--accent-soft);
			}
			.copy__icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}
			.copy__icon--done {
				display: none;
			}
			.copy--inline.is-copied .copy__icon--idle {
				display: none;
			}
			.copy--inline.is-copied .copy__icon--done {
				display: inline-flex;
			}
			.shell__body {
				margin: 0;
				padding: 0.9rem 1.2rem 1rem;
				font-family: var(--mono);
				font-size: 0.86rem;
				line-height: 1.35;
				overflow-x: auto;
			}
			/* Manifest: the working tree after overlays are placed, every file git-excluded. */
			.manifest {
				margin-top: 1.1rem;
				border: 1px solid var(--border);
				border-radius: var(--radius);
				background: var(--surface);
				overflow: hidden;
			}
			.manifest__head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.6rem;
				flex-wrap: wrap;
				padding: 0.6rem 0.9rem;
				border-bottom: 1px solid var(--border);
				background: color-mix(in srgb, var(--surface) 70%, var(--bg));
			}
			.manifest__title {
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--muted);
			}
			.manifest__guard {
				display: inline-flex;
				align-items: center;
				gap: 0.36rem;
				font-size: 0.74rem;
				font-weight: 700;
				color: var(--success);
			}
			.manifest__guard::before {
				content: "";
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--success);
			}
			.manifest__list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.manifest__row {
				display: grid;
				grid-template-columns: 4.6rem minmax(0, 1fr);
				gap: 0.85rem;
				align-items: center;
				padding: 0.6rem 0.9rem;
			}
			.manifest__row + .manifest__row {
				border-top: 1px solid var(--border);
			}
			.manifest__kind {
				justify-self: start;
				font-family: var(--mono);
				font-size: 0.64rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: var(--text-2);
				padding: 0.16rem 0.42rem;
				border-radius: var(--radius-sm);
				border: 1px solid var(--border-strong);
				background: color-mix(in srgb, var(--surface) 60%, var(--bg));
			}
			.manifest__info {
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
			}
			.manifest__file {
				font-size: 0.85rem;
				color: var(--text);
				overflow-wrap: anywhere;
			}
			.manifest__src {
				font-size: 0.72rem;
				color: var(--muted);
				font-family: var(--mono);
				overflow-wrap: anywhere;
			}
			.shell__body .ln {
				display: block;
			}
			.shell__body .pr {
				color: var(--accent);
				font-weight: 700;
				margin-right: 0.4rem;
			}
			.shell__body .dim {
				color: var(--muted);
			}
			.shell__body .ok {
				color: var(--success);
			}
			.caret {
				color: var(--accent);
				animation: blink 1.1s steps(1) infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.caret {
					animation: none;
				}
			}

			/* Problem */
			.problem {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: clamp(2rem, 5vw, 4rem);
				align-items: start;
				border-top: 1px solid var(--border);
			}
			.problem h2 {
				font-size: clamp(1.9rem, 3.6vw, 2.8rem);
			}
			.problem p {
				margin-top: 1.2rem;
				color: var(--text-2);
				max-width: 42ch;
			}
			.configs {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1px;
				background: var(--border);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				overflow: hidden;
			}
			.configs li {
				min-width: 0;
				background: var(--surface);
				padding: 1.2rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.configs span {
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.13em;
				color: var(--muted);
			}
			.configs code {
				font-size: 0.9rem;
				color: var(--text);
				overflow-wrap: anywhere;
			}

			/* Install strip */
			.install-strip {
				display: grid;
				grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
				gap: clamp(1.5rem, 4vw, 3rem);
				align-items: center;
				border-top: 1px solid var(--border);
			}
			.install-strip__eyebrow {
				display: inline-block;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.13em;
				color: var(--muted);
				font-weight: 700;
			}
			.install-strip__line {
				margin-top: 0.7rem;
				color: var(--text-2);
				font-size: 1rem;
				max-width: 34ch;
			}
			.install-strip__options {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.7rem;
			}

			/* Command line: a copyable terminal row */
			.cmdline {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				min-width: 0;
				padding: 0.35rem 0.4rem 0.35rem 0.85rem;
				border-radius: var(--radius-sm);
				background: var(--surface);
				border: 1px solid var(--border);
			}
			.cmdline__manager {
				flex: 0 0 auto;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				font-weight: 700;
				color: var(--muted);
				padding-right: 0.75rem;
				margin-right: 0.1rem;
				border-right: 1px solid var(--border);
			}
			.cmdline__text {
				flex: 1 1 auto;
				min-width: 0;
				overflow-x: auto;
				white-space: nowrap;
				font-family: var(--mono);
				font-size: 0.85rem;
				color: var(--text);
				scrollbar-width: none;
				-webkit-mask-image: linear-gradient(
					to right,
					#000 calc(100% - 1.1rem),
					transparent
				);
				mask-image: linear-gradient(
					to right,
					#000 calc(100% - 1.1rem),
					transparent
				);
			}
			.cmdline__text::-webkit-scrollbar {
				display: none;
			}
			.cmdline .pr {
				color: var(--accent);
				font-weight: 700;
			}

			/* Mechanism: the overlay lifecycle */
			.mechanism {
				border-top: 1px solid var(--border);
			}
			.mechanism__head {
				display: grid;
				gap: 1rem;
				max-width: 60ch;
			}
			.mechanism__sub {
				color: var(--text-2);
				font-size: 1rem;
			}
			.cmdline--browse,
			.cmdline--apply {
				max-width: 30rem;
			}
			.mechanism__track {
				list-style: none;
				margin: clamp(2rem, 4vw, 3rem) 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.1rem;
			}
			.mechanism__stage {
				position: relative;
				min-width: 0;
				padding-top: 1.15rem;
				border-top: 2px solid var(--border-strong);
			}
			.mechanism__stage::before {
				content: "";
				position: absolute;
				top: -2px;
				left: 0;
				width: 34%;
				height: 2px;
				background: var(--accent);
			}
			.mechanism__label {
				display: block;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				font-weight: 700;
				color: var(--muted);
			}
			.mechanism__stage h3 {
				margin-top: 0.45rem;
				font-size: 1.05rem;
				font-weight: 700;
			}
			.mechanism__stage p {
				margin-top: 0.4rem;
				color: var(--text-2);
				font-size: 0.9rem;
			}
			.mechanism__artifact {
				display: inline-block;
				margin-top: 0.7rem;
				font-family: var(--mono);
				font-size: 0.76rem;
				color: var(--text);
				overflow-wrap: anywhere;
			}
			.mechanism__apply {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1.2rem;
				margin-top: clamp(2rem, 4vw, 3rem);
				padding: clamp(1.1rem, 2.5vw, 1.6rem);
				border-radius: var(--radius);
				background:
					radial-gradient(
						90% 120% at 0% 0%,
						var(--accent-soft),
						transparent 60%
					),
					var(--surface);
				border: 1px solid var(--accent-line);
			}
			.mechanism__apply-eyebrow {
				display: inline-block;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				font-weight: 700;
				color: var(--accent);
			}
			.mechanism__apply-copy p {
				margin-top: 0.4rem;
				color: var(--text-2);
				font-size: 0.92rem;
			}
			.mechanism__apply .cmdline {
				flex: 1 1 22rem;
				background: var(--bg-2);
			}

			/* Capabilities: editorial spec list */
			.capabilities {
				border-top: 1px solid var(--border);
			}
			.capabilities__list {
				list-style: none;
				margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0;
			}
			.capability {
				min-width: 0;
				padding: 1.2rem clamp(1rem, 2vw, 1.6rem);
				border-top: 2px solid var(--border-strong);
			}
			.capability + .capability {
				border-left: 1px solid var(--border);
			}
			.capability__head {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.6rem;
			}
			.capability__head h3 {
				font-size: 1.02rem;
				font-weight: 700;
			}
			.capability__code {
				font-family: var(--mono);
				font-size: 0.74rem;
				color: var(--muted);
				overflow-wrap: anywhere;
			}
			.capability p {
				margin-top: 0.6rem;
				color: var(--text-2);
				font-size: 0.9rem;
			}

						/* Final CTA */
			.final {
				text-align: center;
				border-top: 1px solid var(--border);
			}
			.final h2 {
				font-size: clamp(1.9rem, 4vw, 3rem);
			}
			.final p {
				margin: 1.1rem auto 0;
				color: var(--text-2);
				max-width: 46ch;
			}
			.final .cta-row {
				margin-top: 2.2rem;
			}

			/* Footer */
			.foot {
				border-top: 1px solid var(--border);
				background: var(--bg-2);
			}
			.foot__inner {
				max-width: var(--maxw);
				margin: 0 auto;
				padding: 3.5rem 1.5rem 2.5rem;
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				gap: 2.5rem;
			}
			.foot__brand p {
				margin-top: 0.9rem;
				color: var(--muted);
				max-width: 34ch;
				font-size: 0.95rem;
			}
			.foot__cols {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			.foot__cols h4 {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.13em;
				color: var(--muted);
				font-weight: 700;
				margin-bottom: 0.9rem;
			}
			.foot__cols a {
				display: flex;
				align-items: center;
				min-height: 44px;
				color: var(--text-2);
				font-size: 0.95rem;
				padding: 0.25rem 0;
			}
			.foot__cols a:hover {
				color: var(--accent);
			}
			.foot__base {
				max-width: var(--maxw);
				margin: 0 auto;
				padding: 1.3rem 1.5rem;
				border-top: 1px solid var(--border);
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--muted);
			}

			/* Reveal motion is progressive enhancement; content is visible by default. */
			.reveal {
				opacity: 1;
				transform: none;
			}
			@media (prefers-reduced-motion: no-preference) {
				.reveal.is-queued {
					will-change: opacity, transform, filter;
				}
				.reveal.in {
					will-change: auto;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.reveal {
					transform: none;
					transition: none;
				}
				.btn,
				.btn svg,
				.copy {
					transition: none;
				}
				.btn--primary:hover,
				.btn--ghost:hover,
				.btn--primary:hover svg {
					transform: none;
				}
			}
			@media (forced-colors: active) {
				.release__dot {
					background: CanvasText;
				}
				.hero__panel::before,
				.hero__panel::after {
					display: none;
				}
				.btn,
				.copy,
				.shell,
				.manifest,
				.configs,
				.cmdline,
				.mechanism__stage,
				.mechanism__apply,
				.capability {
					border-color: CanvasText;
				}
				.btn--primary {
					background: ButtonText;
					color: ButtonFace;
				}
			}

			@media (pointer: coarse) {
				.copy,
				.copy--inline {
					min-width: 44px;
					min-height: 44px;
				}
				.nav__links a {
					padding-block: 0.35rem;
				}
			}

			/* Responsive */
			@media (max-width: 900px) {
				.hero,
				.problem,
				.foot__inner {
					grid-template-columns: 1fr;
				}
				.hero {
					gap: 2.5rem;
					grid-template-columns: 1fr;
				}
				.hero h1 {
					max-width: min(13ch, 100%);
					font-size: clamp(2.55rem, 10vw, 4.6rem);
				}
				.install-strip {
					grid-template-columns: 1fr;
				}
				.mechanism__track {
					grid-template-columns: 1fr 1fr;
				}
				.capabilities__list {
					grid-template-columns: 1fr;
				}
				.capability {
					padding-inline: 0;
				}
				.capability + .capability {
					border-left: none;
				}
			}
			@media (max-width: 600px) {
				body {
					font-size: 16px;
				}
				main {
					padding-left: max(1rem, env(safe-area-inset-left));
					padding-right: max(1rem, env(safe-area-inset-right));
				}
				.nav__inner {
					padding-left: max(1rem, env(safe-area-inset-left));
					padding-right: max(1rem, env(safe-area-inset-right));
				}
				.nav__links {
					gap: 0.5rem;
					font-size: 0.9rem;
				}
				.configs,
				.foot__cols {
					grid-template-columns: 1fr;
				}
				.mechanism__track {
					grid-template-columns: 1fr;
				}
				.hero__panel {
					padding-block: 1rem;
				}
				.hero__panel::after {
					inset: 1.2rem 0 0.15rem 0.75rem;
				}
				.shell__body {
					font-size: 0.78rem;
				}
				.manifest__row {
					grid-template-columns: 4rem 1fr;
					gap: 0.7rem;
				}
				.copy {
					min-width: 44px;
					min-height: 44px;
					padding-inline: 0.8rem;
				}
				.cta-row .btn {
					flex: 1 1 13rem;
					justify-content: center;
				}
			}
			@media (max-width: 360px) {
				.nav .brand span {
					display: none;
				}
			}
		</style>
	</body>
</html>
