---
interface Props {
	command: string;
	label: string;
}
const { command, label } = Astro.props;
---

<button class="copy copy--inline" type="button" data-copy={command} aria-label={label}>
	<span class="copy__icon copy__icon--idle" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="16" height="16"
			><path
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M9 9V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-4M5 9h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z"
			></path></svg
		>
	</span>
	<span class="copy__icon copy__icon--done" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="16" height="16"
			><path
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M20 6 9 17l-5-5"></path></svg
		>
	</span>
</button>
