{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "repoverlay",
	"compatibility_date": "2026-10-11",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "repoverlay.tylerbutler.com",
			"custom_domain": true
		}
	]
}
